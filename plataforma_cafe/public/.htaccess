Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Bloquear datos, archivos ocultos y artefactos que no deben publicarse.
RewriteRule ^data/ - [F,L]
RewriteRule ^api/api/ - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(log|bak|tmp|old|zip|sql|sha256)$ - [F,L,NC]
# PHP regenera error_log en el servidor y no lleva extensión: exponía
# trazas internas en /api/error_log (respondía 200).
RewriteRule (^|/)error_log$ - [F,L,NC]

# Mantener APIs, assets reales y archivos existentes sin redirecciones.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Los lotes reales publicados no tienen carpeta exportada; usar la vista de marketplace.
RewriteRule ^marketplace/([^/]+)/?$ /marketplace/index.html [L]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(html|json|php)$">
Header set Cache-Control "no-store, no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
