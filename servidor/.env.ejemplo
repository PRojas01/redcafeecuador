# Copia este archivo como .env y ajusta los valores.
DATABASE_URL="postgresql://postgres@localhost:5432/redcafe?host=/tmp"
# 32 bytes en hex: cifrado de cédulas (AES-256-GCM) y huellas HMAC. NO cambiar tras importar.
REDCAFE_CLAVE_DATOS=""
# Carpeta del sitio estático (resultado de fusionar-capa-propia.py).
REDCAFE_SITIO="../staging"
PUERTO=8080
# "produccion" exige HTTPS (cookies Secure, redirección).
REDCAFE_ENTORNO="desarrollo"
