# Copia este archivo como .env (en servidor/) y ajusta los valores.
# Nunca subas el .env al repositorio.

# MySQL 8 o MariaDB 10.6+ (cPanel → Bases de datos MySQL). Base y usuario con TODOS los privilegios.
DATABASE_URL="mysql://USUARIO_cpanel_redcafe:CLAVE@localhost:3306/USUARIO_cpanel_redcafe"
# 32 bytes en hex (openssl rand -hex 32): cifrado de cédulas. NO cambiar tras importar
# o las cédulas ya guardadas quedan ilegibles. Guárdala también fuera del servidor.
REDCAFE_CLAVE_DATOS=""
# "produccion" exige HTTPS (cookies Secure, HSTS, redirección a redcafeecuador.com).
REDCAFE_ENTORNO="produccion"
# Carpeta del sitio estático (export de Next + capa propia, sin api/ ni data/).
REDCAFE_SITIO="/home/USUARIO/redcafe-sitio"
# Fotos y documentos subidos (persisten entre despliegues). Por defecto <sitio>/uploads.
REDCAFE_UPLOADS="/home/USUARIO/redcafe-uploads"
# Copias de seguridad lógicas (fuera del sitio).
REDCAFE_RESPALDOS="/home/USUARIO/redcafe-respaldos"
# Puerto: el hosting suele fijar PORT; si no, se usa este.
PUERTO=8080
# Contraseña de administración para una base nueva (12+ caracteres). Se usa solo
# si la base aún no tiene una; al importar los datos reales se conserva la actual.
REDCAFE_PASS_ADMIN_INICIAL=""
HOST="127.0.0.1"
# 1 si va detrás de nginx/Passenger/Cloudflare (IP real desde X-Forwarded-For).
REDCAFE_PROXY_CONFIABLE=1
# Importación de los datos del sistema PHP desde /admin/importar/ (paquete cifrado).
# Ponla en 1 solo el día de la migración y bórrala después.
# REDCAFE_IMPORTACION=1
REDCAFE_DOMINIO="https://redcafeecuador.com"

# Correo (Resend). Sin clave, los correos se guardan y no se envían.
RESEND_API_KEY=""
REDCAFE_CORREO_REMITENTE="Red Café Ecuador <no-reply@redcafeecuador.com>"
REDCAFE_CORREO_ADMIN="redcafeecuador@gmail.com"

# Opcionales
REDCAFE_WP_BASE=""              # WordPress para noticias/medios (https://…)
REDCAFE_PRICE_OFFICIAL_URL=""   # fuente oficial del precio del café (JSON)

# REDCAFE_PRIVADO: carpeta persistente fuera del sitio y REDCAFE_UPLOADS para documentos privados (por defecto ../redcafe-privado).
