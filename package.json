{
  "name": "redcafeecuador",
  "version": "1.0.0",
  "private": true,
  "description": "Red Café Ecuador — plataforma (servidor Node.js en servidor/, sitio estático en public_html/)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm ci --prefix servidor --include=dev",
    "build": "npm run build --prefix servidor",
    "db:push": "npm run db:push --prefix servidor",
    "importar": "npm run importar --prefix servidor --",
    "start": "node arrancar.cjs"
  },
  "main": "arrancar.cjs"
}
